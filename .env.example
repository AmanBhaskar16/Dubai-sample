# Copy to .env.local (git-ignored) and fill in real values. Never commit .env.local.

# --- MongoDB (required for the Invoicing API) -------------------------------
# Atlas:      mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
# Local RS:   mongodb://127.0.0.1:27017/?replicaSet=rs0
# Standalone: mongodb://127.0.0.1:27017   (works, but without multi-document transactions)
MONGODB_URI=
# Optional. Defaults to the database in the URI path, else "wms_desk".
MONGODB_DB=wms_desk
# Optional. How long to wait for MongoDB before returning 503 (ms).
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# --- Invoice PDF letterhead (optional, shown when a print format has Logo ON) --
INVOICE_SELLER_NAME=Your Company Name FZE
INVOICE_SELLER_ADDRESS=Plot 0, Jebel Ali Free Zone, Dubai, UAE
# INVOICE_SELLER_TAX_ID=100000000000000

# --- API base for the browser (default /api/v1 served by this app) ------------
# NEXT_PUBLIC_API_URL=/api/v1
